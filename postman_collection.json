		{
			"name": "4. Patient-Doctor Mappings",
			"item": [
				{
					"name": "Assign Doctor to Patient",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('mapping_id', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
