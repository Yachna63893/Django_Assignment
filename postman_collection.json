								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"patient_id\": 1,\n    \"doctor_id\": 2,\n    \"notes\": \"Assigned for specialized clinical evaluation and care plan.\"\n}"
